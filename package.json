{
  "name": "bolt",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --filter @bolt/example-api dev",
    "start": "bun run --filter @bolt/example-api start",
    "example:api": "bun run --filter @bolt/example-api start",
    "example:empty": "bun run --filter @bolt/example-empty start",
    "example:routing": "bun run --filter @bolt/example-routing start",
    "example:persistence": "bun run --filter @bolt/example-persistence start",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "check": "bun run typecheck && bun run test && bun test scripts/tests",
    "verify:packages": "bun scripts/verify-packages.ts",
    "verify:registry": "bun scripts/verify-registry.ts",
    "release:check": "bun scripts/release.ts",
    "release:publish": "bun scripts/release.ts --publish",
    "verify:recovery": "bun scripts/verify-recovery.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@typescript/lib-dom": "npm:@types/web@0.0.357",
    "typescript": "7.0.2"
  }
}
