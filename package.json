{
  "name": "bolt",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --filter @bolt/example-empty dev",
    "start": "bun run --filter @bolt/example-empty start",
    "example:routing": "bun run --filter @bolt/example-routing start",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
