import { SqlDatabase, SqlMigrator, sqlMigration } from "@bolt/database";
import { defineEntity, Repository } from "@bolt/orm";
import { Router } from "@bolt/router";
import { BoltApplication } from "@bolt/kernel";
import { S3Storage } from "@bolt/storage";
import { TestClient } from "@bolt/testing";

const url = Bun.env["BOLT_POSTGRESQL_TEST_URL"];
const endpoint = Bun.env["BOLT_S3_ENDPOINT"];
const bucket = Bun.env["BOLT_S3_BUCKET"];
if (!url || !endpoint || !bucket) throw new Error("Registry service verification requires disposable PostgreSQL and S3 test settings");
const suffix = crypto.randomUUID().replaceAll("-", "").slice(0, 10);
const table = `bolt_registry_${suffix}`;
const ledger = `bolt_registry_m_${suffix}`;
const key = `bolt-registry/${suffix}/content`;
const database = SqlDatabase.create({ dialect: "postgresql", url });
const disk = new S3Storage({ endpoint, bucket, accessKeyId: Bun.env["BOLT_S3_ACCESS_KEY_ID"], secretAccessKey: Bun.env["BOLT_S3_SECRET_ACCESS_KEY"], region: Bun.env["BOLT_S3_REGION"] ?? "us-east-1" });
const entity = defineEntity<{ id: string; objectKey: string }>({ table, columns: { id: { primaryKey: true }, objectKey: { name: "object_key" } } });
const repository = new Repository(database, entity);
const router = Router.create();
router.get("/content", async () => {
  const record = await repository.query().where(row => row.id.eq(suffix)).singleOrThrow();
  return new Response(await disk.readStream(record.objectKey));
});
const client = TestClient.create(BoltApplication.create({ router, port: 0, hostname: "127.0.0.1", development: false, shutdownSignals: false }).use(database));
try {
  await database.start();
  await new SqlMigrator(database, [sqlMigration("001_content", [`CREATE TABLE ${table} (id VARCHAR(32) PRIMARY KEY, object_key VARCHAR(100) NOT NULL)`])], { tableName: ledger }).migrate();
  await disk.write(key, "published Bolt with PostgreSQL and S3");
  await repository.insert({ id: suffix, objectKey: key });
  const response = await client.get("/content");
  if (response.status !== 200 || await response.text() !== "published Bolt with PostgreSQL and S3") throw new Error("Published service application failed");
  console.log("Published packages served HTTP content using a real PostgreSQL query and S3 object.");
} finally {
  try { await disk.delete(key); await database.execute(`DROP TABLE IF EXISTS ${table}`); await database.execute(`DROP TABLE IF EXISTS ${ledger}`); }
  finally { await client.close(); await database.close(); }
}
